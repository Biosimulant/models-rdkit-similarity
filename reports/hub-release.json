    "descriptive_metadata": {
      "title": "RDKit Molecular Similarity Search",
      "description": "Rank molecules in your supplied collection using Morgan radius 2, 2048 bits, chirality enabled and Tanimoto similarity. Query/hit drawings, exact scores and downloadable rankings; CPU only.",
      "tags": [],
      "content_trust": "untrusted_descriptive_metadata"
    },
    "intended_use": {
      "statement": "Structural ranking against exactly the supplied collection, <=10000 rows; not a search of all chemistry."
    },
    "caveats": [
      "Morgan radius2, 2048 bits, includeChirality=True; Tanimoto on-bit intersection/union.",
      "No desalt, neutralization or tautomer standardization; preserve all fragments.",
      "Keep all duplicates; ties by descending score, exact Unicode ID then row index.",
      "Structural similarity does not establish potency, activity, toxicity, safety or patent status.",
      "A score of 1 is not identity; exact_match uses canonical isomeric SMILES.",
      "Parity and demonstrations are software verification, not broad biological validation."
    ],
    "prohibited_claims": [
      "Equal potency/activity/toxicity",
      "Patent clearance",
      "Search of all known chemistry",
      "Clinical decisions"
    ],
    "licenses": "BSD-3-Clause",
    "source_references": null,
    "declared_contract": {
      "io": {
        "inputs": [
          {
            "name": "query_smiles",
            "maps_to": "search.query_smiles",
            "signal_type": "scalar",
            "dtype": "str",
            "required": true,
            "value_type": "string",
            "max_length": 8192,
            "description": "One query molecular SMILES; all fragments retained."
          },
          {
            "name": "collection_csv",
            "maps_to": "search.collection_csv",
            "signal_type": "scalar",
            "dtype": "str",
            "required": false,
            "value_type": "string",
            "max_length": 2097152,
            "default": "",
            "description": "Paste UTF-8 molecule_id,smiles CSV; search only this collection, <=10000 rows / 2 MiB."
          },
          {
            "name": "collection_file",
            "maps_to": "search.collection_file",
            "signal_type": "scalar",
            "dtype": "str",
            "required": false,
            "value_type": "file",
            "format": "csv",
            "description": "Upload UTF-8 molecule_id,smiles CSV; <=10000 rows / 2 MiB."
          },
          {
            "name": "top_k",
            "maps_to": "search.top_k",
            "signal_type": "scalar",
            "dtype": "int64",
            "required": false,
            "default": 10,
            "value_type": "integer",
            "description": "Maximum ranked hits; integer 1..100."
          },
          {
            "name": "minimum_similarity",
            "maps_to": "search.minimum_similarity",
            "signal_type": "scalar",
            "dtype": "float64",
            "required": false,
            "default": 0,
            "value_type": "number",
            "description": "Inclusive Tanimoto threshold in [0,1]."
          }
        ],
        "outputs": [
          {
            "name": "report",
            "maps_to": "search.report",
