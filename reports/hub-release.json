            "maps_to": "search.hit_count",
            "signal_type": "scalar",
            "dtype": "int64",
            "emitted_unit": "count"
          },
          {
            "name": "rankings_csv",
            "maps_to": "search.rankings_csv",
            "signal_type": "scalar",
            "dtype": "str",
            "value_type": "file",
            "format": "csv"
          },
          {
            "name": "rankings_json",
            "maps_to": "search.rankings_json",
            "signal_type": "scalar",
            "dtype": "str",
            "value_type": "file",
            "format": "json"
          },
          {
